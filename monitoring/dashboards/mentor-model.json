{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus",
      "description": "공용 Prometheus (monitoring/prometheus-service)"
    },
    {
      "name": "DS_MYSQL",
      "label": "MySQL (mentor-feedback)",
      "type": "datasource",
      "pluginId": "mysql",
      "pluginName": "MySQL",
      "description": "mariadb-1 복제본, DB toxicity (monitoring_인수인계.md 6-1)"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "13.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "mysql",
      "name": "MySQL",
      "version": "1.0.0"
    }
  ],
  "uid": "mentor-model",
  "title": "mentor · 모델",
  "description": "댓글 분류 모델: 서빙 상태 · 예측 분포 · 정답 기반 성능 · 리소스 (k8sapimd/monitoring.md 4-1)",
  "tags": [
    "mentor",
    "mlops"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "모델 교체",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "mysql",
          "uid": "${DS_MYSQL}"
        },
        "target": {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MYSQL}"
          },
          "rawSql": "SELECT UNIX_TIMESTAMP(MIN(created_at)) AS time, CONCAT('모델 ', model_version) AS text, 'model' AS tags\nFROM comment_feedback\nGROUP BY model_version\nHAVING $__timeFilter(MIN(created_at))",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "현재 상태",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "서빙 중인 모델 버전",
      "description": "모델 파드 /metrics 의 toxicity_model_info. 교체가 끝나면 바뀐다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (version) (toxicity_model_info{job=\"mentor\"})",
          "legendFormat": "{{version}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^version$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "학습·서빙 sklearn",
      "description": "학습한 scikit-learn 과 서빙 버전이 다르면 결과를 믿을 수 없다 (가이드 08장).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(toxicity_model_version_mismatch{job=\"mentor\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "정상",
                  "color": "green"
                },
                "1": {
                  "text": "불일치",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "가동 시간",
      "description": "모델을 로드한 뒤 지난 시간",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - max(toxicity_model_loaded_timestamp_seconds{job=\"mentor\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 4,
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "모델 파드 Ready",
      "description": "Ready 인 모델 파드 수 (플랫폼 Watch 캐시)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(mentor_platform_pod_ready{job=\"mentor\",pod=~\"toxicity-filter-.*\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 5,
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "모델 파드 재시작",
      "description": "현재 모델 파드들의 컨테이너 재시작 횟수 합",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(mentor_platform_pod_restarts{job=\"mentor\",pod=~\"toxicity-filter-.*\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 6,
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "row",
      "title": "서빙",
      "collapsed": false,
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "추론 요청 (1시간 단위)",
      "description": "ok = 정상 / bad_request = 길이 검증 실패 / error = 예외",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (result) (increase(toxicity_predict_requests_total{job=\"mentor\"}[1h]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "auto",
            "spanNulls": true,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "추론 평균 시간",
      "description": "predict_proba 계산 시간 (15분 평균). 플랫폼의 모델 호출 제한 시간은 3초.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(toxicity_predict_duration_seconds_sum{job=\"mentor\"}[15m])) / sum(rate(toxicity_predict_duration_seconds_count{job=\"mentor\"}[15m]))",
          "legendFormat": "평균",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true,
            "lineInterpolation": "stepAfter",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "모델 호출 실패 (플랫폼 기준, 1시간)",
      "description": "timeout / connect / http_4xx / http_5xx / invalid",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (reason) (increase(mentor_platform_model_call_failures_total{job=\"mentor\"}[1h]))",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "auto",
            "spanNulls": true,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "예측 분포 (정답 없이 보는 변화)",
      "collapsed": false,
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "barchart",
      "title": "예측 확률 분포 (버전별, 대시보드 기간)",
      "description": "가로축 = 확률 상한(le), 값 = 그 이하인 예측 수(누적). 0.4~0.6 구간 기울기가 크면 확신 없는 예측이 많은 것.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (le, model_version) (increase(toxicity_predict_proba_bucket{job=\"mentor\",le!=\"+Inf\"}[$__range]))",
          "legendFormat": "{{model_version}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "xField": "le",
        "orientation": "vertical",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "model_version",
            "rowField": "le",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "le\\model_version",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "le\\model_version"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "le\\model_version": "le"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "le",
                "destinationType": "string"
              }
            ]
          }
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "유해 판정 비율 (버전별, 1시간)",
      "description": "임계값 판정 결과 중 '주의' 비율. 모델 교체 전후로 비교.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (model_version) (increase(mentor_platform_classify_total{job=\"mentor\",pred_label=\"1\"}[1h])) / sum by (model_version) (increase(mentor_platform_classify_total{job=\"mentor\"}[1h]))",
          "legendFormat": "{{model_version}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true,
            "lineInterpolation": "stepAfter",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "stat",
      "title": "학습 범위 밖 입력 (32자 초과)",
      "description": "학습 데이터는 9~32자 짧은 댓글 → 이보다 긴 입력은 모델이 배운 적 없는 형태",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "1 - sum(increase(toxicity_input_length_chars_bucket{job=\"mentor\",le=\"32.0\"}[$__range])) / sum(increase(toxicity_input_length_chars_count{job=\"mentor\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.3,
                "color": "orange"
              },
              {
                "value": 0.6,
                "color": "red"
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "현재 임계값",
      "description": "확률 ≥ 임계값 → 주의 (플랫폼 THRESHOLD)",
      "datasource": {
